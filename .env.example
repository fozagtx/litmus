# ── Backblaze B2 ────────────────────────────────────────────────────────────
# Easiest: put your master key here and run scripts/bootstrap_b2.py once.
# It creates the three buckets (vault with Object Lock, irreversible), mints
# a scoped runtime key, and fills in the six values below it.
B2_MASTER_KEY_ID=
B2_MASTER_APP_KEY=

B2_REGION=
B2_KEY_ID=
B2_APP_KEY=
B2_ASSETS_BUCKET=
B2_VAULT_BUCKET=
B2_STATE_BUCKET=

# ── AI stack ────────────────────────────────────────────────────────────────
# Judge (qwen-vl-plus vision) + narration text (qwen3.6-flash) run on Alibaba
# DashScope (Model Studio intl): https://modelstudio.console.alibabacloud.com
DASHSCOPE_API_KEY=
# Narration voice. Free tier: https://elevenlabs.io → profile → API keys
ELEVENLABS_API_KEY=

# Images: "pollinations" (default, keyless and free) or "alibaba" (DashScope
# wan/qwen image models). With a DASHSCOPE_API_KEY set, Pollinations outages
# automatically fail over to Alibaba for new runs.
IMAGE_PROVIDER=pollinations
# Leave blank for per-provider defaults (pollinations: flux/turbo,
# alibaba: wan2.7-image). Validate: scripts/check_providers.py
IMAGE_MODEL=
IMAGE_FALLBACK_MODELS=
JUDGE_MODEL=
NARRATION_TEXT_MODEL=
TTS_MODEL=eleven_multilingual_v2
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Sealing ─────────────────────────────────────────────────────────────────
# COMPLIANCE-mode retention. 7 days for the demo; 365+ for production.
# Irreversible per object once written — see README "Important limits".
VAULT_RETENTION_DAYS=7
SIGNING_KEY_PATH=data/signing_key.pem

# ── Pipeline tuning ─────────────────────────────────────────────────────────
JUDGE_THRESHOLD=70
MAX_ATTEMPTS=3
PHASH_MAX_DISTANCE=10

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
