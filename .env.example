# ── Backblaze B2 ────────────────────────────────────────────────────────────
# Create an application key with read+write access to the three buckets.
# The vault bucket MUST be created with Object Lock enabled (scripts/create_buckets.py
# does this — it cannot be enabled on an existing bucket).
B2_REGION=us-west-004
B2_KEY_ID=
B2_APP_KEY=
# Bucket names are globally unique on B2 — pick your own suffix.
B2_ASSETS_BUCKET=lm-assets-CHANGEME
B2_VAULT_BUCKET=lm-vault-CHANGEME
B2_STATE_BUCKET=lm-state-CHANGEME

# ── Providers ───────────────────────────────────────────────────────────────
GMI_API_KEY=
ELEVENLABS_API_KEY=

# ── Models (validate against your account with scripts/check_providers.py) ─
IMAGE_MODEL=seedream-4-0
IMAGE_FALLBACK_MODELS=flux-kontext-pro
JUDGE_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
NARRATION_TEXT_MODEL=deepseek-ai/DeepSeek-V3
TTS_MODEL=eleven_multilingual_v2
TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Sealing ─────────────────────────────────────────────────────────────────
# COMPLIANCE-mode retention. 7 days for the demo; 365+ for production.
# Irreversible per object once written — see README "Honest limitations".
VAULT_RETENTION_DAYS=7
SIGNING_KEY_PATH=data/signing_key.pem

# ── Pipeline tuning ─────────────────────────────────────────────────────────
JUDGE_THRESHOLD=70
MAX_ATTEMPTS=3
PHASH_MAX_DISTANCE=10

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
